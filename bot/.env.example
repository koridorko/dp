# Copy to bot/.env and fill in values. The app loads bot/.env via python-dotenv (project root).

# --- Matrix bot (MatrixBot: login, m.call.* events, room messages) ---
# Bot localpart / login username on the homeserver.
MATRIX_BOT_USERNAME=
# Bot account password.
MATRIX_BOT_PASSWORD=
# Homeserver base URL (e.g. https://matrix.org).
MATRIX_BOT_HOMESERVER=
# On password login these are overwritten by the server response; may be left empty.
MATRIX_BOT_ACCESS_TOKEN=
MATRIX_BOT_USER_ID=

# --- Asterisk ARI (sip_bridge WebSocket + REST; must match config/asterisk/ari.conf) ---
# ARI HTTP base URL (no trailing slash), e.g. http://127.0.0.1:8088.
ASTERISK_ARI_URL=
# ARI HTTP user from ari.conf.
ASTERISK_ARI_USER=
# ARI HTTP password.
ASTERISK_ARI_PASSWORD=
# Stasis application name (same string as in the dialplan).
ASTERISK_STASIS_APP=

# --- Linphone SIP account (used when resolving caller identity for Matrix notifications) ---
# SIP domain host:port as configured in Linphone (matches your Asterisk/PJSIP setup).
ASTERISK_SIP_DOMAIN=
# SIP account username (Linphone user).
ASTERISK_SIP_USER=
# SIP account password (Linphone password).
ASTERISK_SIP_PASSWORD=

# --- Matrix → SIP reverse bridge (matrix_bridge: 1:1 pairing with your user) ---
# Your MXID; the bot waits for a 1:1 room with only this user (invite / pairing).
MY_MATRIX_USERNAME=

# --- pyVoIP outbound SIP (matrix_bridge: registration at your SIP provider) ---
# SIP provider / registrar hostname for REGISTER and INVITE domain.
REVERSE_PYVOIP_SERVER=
# SIP account username at the provider.
REVERSE_PYVOIP_USER=
# SIP account password at the provider.
REVERSE_PYVOIP_PASSWORD=
# SIP signaling port at the provider (often 5060).
REVERSE_PYVOIP_PORT=
# Local UDP port where pyVoIP listens for SIP (avoid clashing with other apps on 5060).
REVERSE_PYVOIP_SIP_BIND_PORT=
